{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Castcorder",
  "version": "0.0.0",
  "identifier": "app.castcorder.desktop",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["castcorder"]
      }
    }
  }
}
